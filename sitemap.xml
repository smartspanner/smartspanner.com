---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% comment %}Retain jekyll-sitemap's page/collection/static-document exclusions, with support for an explicit page canonical.{% endcomment %}
{% for collection in site.collections %}{% unless collection.output == false %}{% for doc in collection.docs %}{% unless doc.sitemap == false %}
  <url><loc>{{ doc.canonical_url | default: doc.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>{% assign modified = doc.last_modified_at | default: doc.date %}{% if modified %}<lastmod>{{ modified | date_to_xmlschema }}</lastmod>{% endif %}</url>
{% endunless %}{% endfor %}{% endunless %}{% endfor %}
{% for entry in site.html_pages %}{% unless entry.sitemap == false or entry.url == '/404.html' %}
  <url><loc>{{ entry.canonical_url | default: entry.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>{% if entry.last_modified_at %}<lastmod>{{ entry.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}</url>
{% endunless %}{% endfor %}
{% for file in site.static_files %}{% assign extension = file.extname | downcase %}{% if extension == '.htm' or extension == '.html' or extension == '.xhtml' or extension == '.pdf' %}{% unless file.sitemap == false or file.name == '404.html' %}
  <url><loc>{{ file.path | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc><lastmod>{{ file.modified_time | date_to_xmlschema }}</lastmod></url>
{% endunless %}{% endif %}{% endfor %}
</urlset>
